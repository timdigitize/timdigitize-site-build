<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <rule name="Serve WebP" stopProcessing="true">
          <match url="^(.+)\.(png|jpg|jpeg)$" />
          <conditions>
            <add input="{HTTP_ACCEPT}" pattern="image/webp" />
            <add input="{REQUEST_FILENAME}.webp" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.{R:2}.webp" />
        </rule>
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Drop www" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.(.+)$" />
          </conditions>
          <action type="Redirect" url="https://{C:1}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Legacy 0" stopProcessing="true">
          <match url="^about\.html$" />
          <action type="Redirect" url="/en/about/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy 1" stopProcessing="true">
          <match url="^contacts\.html$" />
          <action type="Redirect" url="/en/contact/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy 2" stopProcessing="true">
          <match url="^detail_page_nova100\.html$" />
          <action type="Redirect" url="/en/products/nova-100/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy 3" stopProcessing="true">
          <match url="^detail_page_nova110\.html$" />
          <action type="Redirect" url="/en/products/nova-110/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy 4" stopProcessing="true">
          <match url="^detail_page_nova130\.html$" />
          <action type="Redirect" url="/en/products/nova-130/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy 5" stopProcessing="true">
          <match url="^detail_page_nova200\.html$" />
          <action type="Redirect" url="/en/products/nova-200/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy 6" stopProcessing="true">
          <match url="^detail_page_hydra500\.html$" />
          <action type="Redirect" url="/en/products/hydra-500/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy 7" stopProcessing="true">
          <match url="^detail_page_hydra700\.html$" />
          <action type="Redirect" url="/en/products/hydra-700/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy 8" stopProcessing="true">
          <match url="^detail_page_hydra300\.html$" />
          <action type="Redirect" url="/en/products/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy 9" stopProcessing="true">
          <match url="^detail_page_aqua500\.html$" />
          <action type="Redirect" url="/en/products/aqua-500/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy 10" stopProcessing="true">
          <match url="^detail_page_timapp\.html$" />
          <action type="Redirect" url="/en/products/tim-app/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy 11" stopProcessing="true">
          <match url="^detail_page_ecukit\.html$" />
          <action type="Redirect" url="/en/products/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy 12" stopProcessing="true">
          <match url="^static/documents/nova\-100\-manual\.pdf$" />
          <action type="Redirect" url="/en/products/nova-100/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy 13" stopProcessing="true">
          <match url="^static/documents/nova\-110\-manual\.pdf$" />
          <action type="Redirect" url="/en/products/nova-110/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy 14" stopProcessing="true">
          <match url="^static/documents/nova\-130\-manual\.pdf$" />
          <action type="Redirect" url="/en/products/nova-130/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy 15" stopProcessing="true">
          <match url="^static/documents/nova\-200\-manual\.pdf$" />
          <action type="Redirect" url="/en/products/nova-200/" redirectType="Permanent" />
        </rule>
        <rule name="Locale-less path" stopProcessing="true">
          <match url="^(products|blog|tools|shop|contact|about|compare|demo|case-studies|resources|privacy|terms|cookies|nova-200)(/.*)?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Redirect" url="/?to=/{R:0}" redirectType="Found" appendQueryString="false" />
        </rule>
        <rule name="Legacy bare timsantarim link" stopProcessing="true">
          <match url="^(.*/)?timsantarim\.com/?$" />
          <action type="Redirect" url="https://timsantarim.com/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy detail pages" stopProcessing="true">
          <match url="^detail_page_.*\.html$" />
          <action type="Redirect" url="/en/products/" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="en\404\index.html" responseMode="File" />
    </httpErrors>

    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="01:00:00" />
    </staticContent>

    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".com" allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="Permissions-Policy" value="geolocation=(self), camera=(), microphone=(), payment=()" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
